{
  "gate": "DQ_GATE_04_LABEL_CONSTRUCT_VALIDITY",
  "version": "1.0",

  "problem": {
    "unit_of_analysis": "order_id",
    "prediction_time": "order_purchase_timestamp",
    "target_concept": "violation of the delivery promise informed to the customer"
  },

  "candidate_labels": {
    "timestamp_strict": {
      "formula": "delivered_timestamp > estimated_delivery_timestamp",
      "role": "candidate"
    },

    "calendar_day": {
      "formula": "delivery_calendar_date > estimated_delivery_calendar_date",
      "role": "candidate"
    },

    "calendar_day_plus_1_grace": {
      "formula": "delivery_calendar_date > estimated_delivery_calendar_date + 1 day",
      "role": "sensitivity_only"
    }
  },

  "recommendation_rule": {
    "estimated_midnight_pct_min": 99.9,
    "disagreement_same_calendar_day_pct_min": 99.9
  },

  "observation_window": {
    "end_rule": "maximum observed order_delivered_customer_date",
    "do_not_convert_unobserved_to_negative": true
  },

  "principles": {
    "construct_validity_before_final_label": true,
    "unobserved_outcome_is_not_on_time": true,
    "terminal_non_delivery_is_not_delivery_delay": true,
    "raw_is_immutable": true,
    "label_is_not_finalized_automatically": true
  }
}
